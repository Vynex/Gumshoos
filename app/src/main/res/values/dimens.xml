<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Drawn size of the app icon widget's icon. Deliberately a fixed size centred in the cell rather than
      match_parent: launcher cells are much larger than an app icon, so filling the cell is exactly
      what made the widget read as oversized next to real icons. Overridden at runtime from GumshoosConfig, so this is
      only the initial value — tune it from the app's App icon widget screen instead.
    -->
    <dimen name="widget_icon_size">46dp</dimen>

    <!--
      Wide search bar metrics. Referenced from widget_search_bar.xml and, via dimensionResource,
      from the settings preview — one source, so the preview can't quietly disagree with the widget
      about how much room the logo takes or how far the content sits from the edge.
    -->
    <dimen name="widget_bar_inset">18dp</dimen>
    <dimen name="widget_bar_gap">12dp</dimen>
    <dimen name="widget_bar_logo_size">22dp</dimen>
    <dimen name="widget_bar_action_size">22dp</dimen>

</resources>
