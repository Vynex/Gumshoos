<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon is a fixed size centred near the top of the cell, not match_parent. Launcher cells are
  considerably larger than an app icon, so filling the cell is what made this read as a widget
  rather than an app.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:layout_width="@dimen/widget_icon_size"
        android:layout_height="@dimen/widget_icon_size"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/widget_icon_top_margin"
        android:contentDescription="@string/widget_search_hint"
        android:src="@drawable/ic_widget_search_app" />

</FrameLayout>
