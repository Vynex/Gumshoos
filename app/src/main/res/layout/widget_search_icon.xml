<?xml version="1.0" encoding="utf-8"?>
<!--
  Centred, not top-aligned: launchers draw an app icon in the middle of its cell (some a little
  lower), and the label sits below within the same cell. The icon's size and vertical offset are
  overridden at runtime from GumshoosConfig, so these values are only the initial state.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="@dimen/widget_icon_size"
        android:layout_height="@dimen/widget_icon_size"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_search_hint"
        android:src="@drawable/ic_widget_search_app" />

</FrameLayout>
