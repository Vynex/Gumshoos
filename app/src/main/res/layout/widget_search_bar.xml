<?xml version="1.0" encoding="utf-8"?>
<!--
  The wide search bar.

  The background is an ImageView rather than a View background because it is rasterised at runtime —
  RemoteViews cannot set a Drawable, and shape drawables cannot cast a shadow. The static src is
  what the launcher's widget picker shows, and what a placed widget looks like for the instant
  before the first update lands; the bitmap replaces it immediately after.

  Action slots are fixed at five because RemoteViews cannot add views. WidgetAction.SLOT_COUNT
  mirrors this number and a unit test holds the two together — four so that every action can be on
  at once, rather than one of them being permanently unreachable.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_search_bar_bg" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_bar_inset"
        android:paddingEnd="@dimen/widget_bar_inset">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="@dimen/widget_bar_logo_size"
            android:layout_height="@dimen/widget_bar_logo_size"
            android:contentDescription="@string/widget_search_hint"
            android:src="@drawable/ic_provider_search" />

        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:text="@string/widget_search_hint"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_hint_text" />

        <!--
          A weighted spacer of its own, rather than weighting the hint. Weighting the hint would let
          the actions slide left the moment the hint is hidden, which is a setting away.

          An empty FrameLayout, and NOT <View> or <Space>. RemoteViews inflates in the launcher's
          process behind a filter that only admits classes annotated @RemoteViews.RemoteView, and
          neither of those carries it — the layout then fails to inflate and the launcher shows
          "An error occurred when loading widget" with nothing to say which view was at fault.
          The full permitted set is FrameLayout, LinearLayout, RelativeLayout, GridLayout,
          AbsoluteLayout, TextView, TextClock, Button, ImageButton, ImageView, ProgressBar,
          AnalogClock, Chronometer, CheckBox, RadioButton, RadioGroup, Switch, ViewStub,
          ViewFlipper, AdapterViewFlipper, ListView, GridView and StackView.
        -->
        <FrameLayout
            android:id="@+id/widget_spacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!--
          Each slot is a TextClock, a TextView and an ImageView, and exactly one of the three is
          ever visible. RemoteViews cannot reorder or add views, so the only way any action can be
          dragged to any position is for every position to be able to draw every kind. A GONE view
          costs no width, so a trio reads as a single slot.

          TextClock is not interchangeable with the TextView beside it. A widget does not redraw
          itself, so a plain view shows whatever it was last handed until something pushes more:
          fine for weather, which owns a staleness policy and a refresh, and wrong for a date, which
          would sit on yesterday. TextClock re-evaluates its own format on a ticker — once a minute
          with no seconds in the pattern — registers for TIME_CHANGED and TIMEZONE_CHANGED itself,
          and stops ticking off screen via onVisibilityAggregated. Read out of the android-36
          sources rather than assumed.

          Both TextClock format attributes are set because it picks between them on the device's
          12/24-hour setting, and this pattern carries no time for that choice to be about. They are
          replaced at runtime with a locale-appropriate pattern; these are for layout preview only.
        -->
        <TextClock
            android:id="@+id/widget_date_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_text_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_action_1"
            android:layout_width="@dimen/widget_bar_action_size"
            android:layout_height="@dimen/widget_bar_action_size"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/widget_date_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_text_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_action_2"
            android:layout_width="@dimen/widget_bar_action_size"
            android:layout_height="@dimen/widget_bar_action_size"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/widget_date_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_text_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_action_3"
            android:layout_width="@dimen/widget_bar_action_size"
            android:layout_height="@dimen/widget_bar_action_size"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/widget_date_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_text_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_action_4"
            android:layout_width="@dimen/widget_bar_action_size"
            android:layout_height="@dimen/widget_bar_action_size"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/widget_date_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_text_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/widget_bar_slot_text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_action_5"
            android:layout_width="@dimen/widget_bar_action_size"
            android:layout_height="@dimen/widget_bar_action_size"
            android:layout_marginStart="@dimen/widget_bar_gap"
            android:contentDescription="@null"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
