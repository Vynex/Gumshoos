<?xml version="1.0" encoding="utf-8"?>
<!-- Lucide "terminal". Stroke icon: hand-authored, since the convert pipeline is built for filled
     logos and drops the root-level stroke these carry. 24dp canvas, tintable via android:tint. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,19 h8 M4,17 l6,-6 l-6,-6" />
</vector>
