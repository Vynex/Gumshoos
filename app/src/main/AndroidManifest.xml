<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
      Special access, granted by the user in Settings rather than a runtime dialog. Powers
      most-recently-opened ordering; without it, ordering falls back to alphabetical.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional: without it the contacts section simply doesn't appear. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Coarse only, and never fine: this decides which city's weather the bar shows, which a
      network-grade fix answers exactly as well as GPS would. Optional in every sense — refused, the
      weather action still works from a typed place name, and nothing else in the app reads it.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      Required to trigger the system uninstall dialog when targeting API 28+. Without it the intent
      is simply refused. Normal permission, granted at install, and it only lets us *ask* — the
      system still shows its own confirmation.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Exchange rates only: fetched once a day at warm time, cached to disk, never on the show path. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Package visibility filtering (Android 11+) hides other apps from queryIntentActivities unless
      they are declared here. Scoped to launchable activities rather than QUERY_ALL_PACKAGES, which
      is what we actually need and avoids a sensitive broad permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
          Schemes the "Search using" row hands off to. Without these, package visibility filtering
          makes the deep links unresolvable and every provider silently falls back to the browser.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="spotify" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <!--
          Resolved to find which app handles each contact action, so the row can show that app's
          real icon rather than a generic glyph.
        -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <package android:name="com.whatsapp" />
        <!--
          Checked for installation, and forced on the intent so the browser can't claim the link.
          The MAIN/LAUNCHER query above already makes both visible; these are declared by name
          because that is the lookup the availability check actually performs.
        -->
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.spotify.music" />

        <!--
          Targets of the search bar's action icons. The intent filters cover resolving a handler;
          the named packages are for the explicit fallbacks each chain ends with, which resolve by
          package rather than by action.
        -->
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <intent>
            <action android:name="android.speech.action.WEB_SEARCH" />
        </intent>
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.apps.bard" />

        <!--
          Inspected by the Lens probe in Advanced. Declared by name because package visibility
          filtering makes an invisible app indistinguishable from an absent one — the probe would
          report "not installed" for something sitting right there, which is the wrong answer to
          the exact question it is being asked.
        -->
        <package android:name="com.google.ar.lens" />
        <package android:name="com.google.android.apps.photos" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <!--
      No android:roundIcon, deliberately. It was introduced in API 25 for launchers that wanted a
      circular icon; from API 26 an adaptive icon is masked by the launcher to whatever shape it
      likes, so at minSdk 31 the attribute can never be reached. Pointing it at a round asset we
      no longer ship would be a broken reference, and generating one would be dead weight.
    -->
    <application
        android:name=".GumshoosApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gumshoos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Reached from the pinned shortcut and, when enabled, a second launcher icon. taskAffinity
          is empty so it never joins or disturbs the main task.
        -->
        <activity
            android:name=".LaunchSearchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gumshoos.Invisible" />

        <!--
          Reached from the search bar widget's action icons. Same shape as LaunchSearchActivity, and
          exported for the same reason: a PendingIntent held by the launcher starts it. It exists
          because a PendingIntent carries one Intent and these destinations each need a fallback
          chain — see WidgetActionActivity.
        -->
        <activity
            android:name=".WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gumshoos.Invisible" />

        <!--
          A second app-drawer icon that opens search directly. Disabled by default and toggled from
          the app, which is what makes it configurable: enabling the component is what makes the
          icon appear.
        -->
        <activity-alias
            android:name=".SearchShortcut"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_search_app"
            android:label="@string/search_shortcut_label"
            android:targetActivity=".LaunchSearchActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          What makes Gumshoos eligible to be the phone's assistant: an app appears in the system's
          assistant picker by declaring an activity that handles ASSIST. Disabled by default and
          switched on from Settings, like the drawer icon alias above — a filter declared
          unconditionally would sit in the picker whether or not the option was ever wanted.

          Aimed at LaunchSearchActivity because assist arrives as an activity launch and so needs
          the same trampoline a shortcut does; the activity tags the show "assist" by the incoming
          action, so the latency readout keeps this path separate from the icon's.
        -->
        <activity-alias
            android:name=".AssistTrigger"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_search_app"
            android:label="@string/assist_trigger_label"
            android:targetActivity=".LaunchSearchActivity">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".NoOpActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the search overlay window pre-attached so it can be shown without an activity launch" />
        </service>

        <service
            android:name=".SearchTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_search"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".SearchWidgetProvider"
            android:exported="true"
            android:label="@string/widget_bar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_info" />
        </receiver>

        <receiver
            android:name=".SearchWidgetSmallProvider"
            android:exported="true"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_small_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Re-pushes placed widgets after an upgrade. Not exported: MY_PACKAGE_REPLACED is delivered
          to us by the system, and nothing else has any business triggering it.
        -->
        <receiver
            android:name=".WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <!--
              PACKAGE_FULLY_REMOVED, so an action whose app is uninstalled stops being drawn even if
              nothing of ours is running. It is on the implicit-broadcast exception list where
              PACKAGE_ADDED and PACKAGE_REMOVED are not, which is why only the uninstall direction is
              covered here; the install direction is handled when settings next resumes.

              Belt and braces, not the mechanism — the receiver only re-pushes RemoteViews and must
              never warm the service, which would be a background foreground-service start.
            -->
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
