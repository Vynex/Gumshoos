# Copy this file to app/keystore.properties and fill it in. That copy is gitignored and must stay
# that way — it holds the password to the key that every future release is signed with.
#
# Generate the keystore first (it will prompt for a password; nothing is echoed):
#
#   mkdir -p ~/keystores
#   keytool -genkeypair -v \
#     -keystore ~/keystores/gumshoos-release.jks \
#     -storetype PKCS12 -alias gumshoos \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=vynex, O=Gumshoos"
#
# PKCS12 keeps one password for the store and the key, so storePassword and keyPassword are the same
# value. keytool warns if they differ.
#
# BACK THE KEYSTORE UP somewhere that is not this machine. Losing it means no future build can update
# an installed Gumshoos — the only route back is uninstalling, which wipes every setting.

storeFile=~/keystores/gumshoos-release.jks
storePassword=
keyAlias=gumshoos
keyPassword=
